# ==========================================
# AI Crime Analysis System — Configuration
# ==========================================

# Database Configuration (PostgreSQL + PostGIS)
# For Local Docker or Self-hosted:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crime_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crime_db

# For Hosted Supabase (PostgreSQL + PostGIS):
# Replace [YOUR-PASSWORD] with your Supabase database password:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[your-project-ref].supabase.co:5432/postgres
# Or Session Pooler (port 5432) / Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Project Credentials (Dummy placeholders for example)
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Backend Configuration
PROJECT_NAME="AI Crime Analysis System"
ENVIRONMENT=development
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Frontend Configuration
